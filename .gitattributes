# LF everywhere, on every platform: several files (agent skill, CLI, scripts)
# are embedded into the app exactly as they are checked out.
* text=auto eol=lf

# Windows command scripts need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Third-party license texts are kept byte for byte.
apps/web/public/THIRD-PARTY-NOTICES.txt -text
