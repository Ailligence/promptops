# Minimal stub frontend used only to make `cargo check`/`tauri dev` pass
# until `frontendDist` points to the real Angular webapp build.
/dist-stub/

# Rust build artifacts (~9 GB) — NEVER the src-tauri sources: the previous
# rule was `src-tauri` and made every new module invisible to git.
/src-tauri/target/

# ACL schemas regenerated by the Tauri CLI on every build.
/src-tauri/gen/schemas/

# node_modules is already ignored by the root .gitignore, but we restate it here
# (prebuilt Tauri CLI @tauri-apps/cli + @xenova/transformers for the sidecar).
/node_modules/
